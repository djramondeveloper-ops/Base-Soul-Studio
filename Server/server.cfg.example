# ============================================================
# SEOUL BASE - server.cfg.example
# Arquivo de exemplo seguro para GitHub.
# Copie para server.cfg e preencha os valores marcados como SEU_/SUA_.
# NUNCA publique seu server.cfg real com chaves, senhas ou webhooks.
# ============================================================

# CONFIGURAÇÕES DE REDE
# Porta TCP/UDP padrão do servidor (não altere se não precisar)
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

# BANCO DE DADOS (MySQL)
# String de conexão com o banco de dados (ajuste conforme seu MySQL)
# Se seu MySQL não tiver senha, apenas remova a palavra em maiusculo SENHA
# Altere a palavra em maiusculo DATABASE para o nome do seu Banco de Dados(sinta-se livre para escolher um nome)
set mysql_connection_string "server=127.0.0.1;uid=root;password=SUA_SENHA;database=SEU_BANCO;port=3306;charset=utf8mb4"

# Nível de isolamento de transações (2 = READ COMMITTED, recomendado)
set mysql_transaction_isolation_level 2

# Alerta no console quando uma query demora mais de X ms (100ms neste caso)
set mysql_slow_query_warning 100

# PERMISSÕES
# Adiciona o seu Steam ID ao grupo Admin, garantindo permissões administrativas.
add_principal identifier.steam:SUA_STEAM_HEX group.Admin

# Permite que o grupo "Admin" use todos os comandos do servidor.
add_ace group.Admin command allow

# Bloqueia que o grupo "Admin" use o comando "quit" (para evitar que admins desliguem o servidor acidentalmente).
add_ace group.Admin command.quit deny

# Permite os players a configurar com /ox_lib
setr ox:userLocales 1

## Permissoes
add_ace resource.ox_lib command.add_ace allow
add_ace resource.ox_lib command.remove_ace allow
add_ace resource.ox_lib command.add_principal allow
add_ace resource.ox_lib command.remove_principal allow

# ======================
# SEOUL OX CONFIG
# ======================

setr seoul:useOxInventory true
setr seoul:useOxTarget true

setr inventory:framework "vrp"
setr inventory:target true
setr inventory:slots 50
setr inventory:weight 30000

setr inventory:keys ["OEM_3","NONE","TAB"]
set inventory:accounts []
setr inventory:imagepath "nui://ox_inventory/web/images"

setr ox_target:defaultHotkey LMENU

# RESOURCES - ordem crítica
ensure oxmysql
ensure ox_lib
ensure seoul_uipack

ensure vrp

ensure ox_target
ensure ox_inventory
ensure ox_doorlock

start [nation]
ensure AdminControl

ensure target

start [system]
start [seoul]
start [qbcore]
start [phone]
start [creative]
start [addons]

# Sistemas extras se existirem
# start [maps]
# start [gabz]
# start [weapons]
# start [clothes]
# start [vehicles]

# ONESYNC (sincronização avançada)
# Ativa o OneSync, permitindo suporte a mais jogadores simultâneos e sincronização avançada.
set onesync on

# Garante que jogadores antigos do servidor sejam migrados para o modo OneSync corretamente.
set onesync_forceMigration true

# Ativa a população dinâmica (NPCs, pedestres e carros) em servidores OneSync.
set onesync_population true

# Melhora performance ao remover temporariamente veículos que estão longe dos jogadores.
set onesync_distanceCullVehicles true

# Ativa uma correção para um bug específico do OneSync (relacionado ao ID do bug 763185).
set onesync_workaround763185 true

# SEGURANÇA & PRIVACIDADE
# Bloqueia ScriptHook (antigos trainers/mod menus)
sv_scriptHookAllowed 0

# Oculta IPs reais no console/logs
sv_endpointprivacy false

# Senha RCON (caso queira permitir controle remoto)
# rcon_password SENHA_AQUI

# Define Pure Mode (anti-cheat de integridade de arquivos)
# 0 = Desativado | 1 = L1 (checa resources) | 2 = L2 (checa também assets do GTA)
sv_pureLevel 0

# INFORMAÇÕES DO SERVIDOR (LISTA FIVEM)
# Palavras-chave para achar o servidor
sets tags "rp, roleplay, creative, network, pvp, br, brasil, brazil, otimizado, fps, foguete, lotus, complexo, santa, paris, tokyo, fusion, space, disney, infinity, fluxo, havana, kush, dubai, brazuka, nexus, capital, one, street, north, meta, hensa"

# Idioma do servidor
sets locale "pt-BR"

# Ícone do servidor (arquivo .png na raiz da pasta)
load_server_icon server.png

# Master server (deixe vazio para usar o padrão)
sv_master1 ""

# WEBHOOKS DISCORD
# Webhook usado pelo servidor (exemplo: MDT, PAINEL, FREECAM e Etc)
setr Discord_MDT "SEU_WEBHOOK_DISCORD_MDT"
setr Discord_PAINEL "SEU_WEBHOOK_DISCORD_PAINEL"
setr Discord_FREECAM "SEU_WEBHOOK_DISCORD_FREECAM"

# CONFIGURAÇÕES DE VOZ (Mumble)
# Quantidade máxima de conexões por IP no Mumble
set mumble_maxClientsPerIP 1024

# Usa apenas range de proximidade (sem canal global)
setr voice_useSendingRangeOnly true

# INFORMAÇÕES DE IDENTIDADE (APARECE NO CONECTAR)
# Nome que aparece na lista do FiveM
sv_hostname "Seoul: Bases - Roleplay"

# Nome e descrição do projeto
sets sv_projectName "Seoul: Bases - Roleplay"
sets sv_projectDesc "Desenvolva sua historia, troque seu tiro e divirta-se"

# Informações adicionais
sets Grupo "seoul Bases"
sets Desenvolvedor "DjRamon/SeoulDev"
sets Discord "https://discord.gg/SEU_CONVITE"
sets Site "https://seusite.com"

# Banners exibidos no F8 connect e na tela de carregamento
sets banner_detail ""
sets banner_connecting ""

# CAPACIDADE DO SERVIDOR
# Desativa o balanço da câmera para os clientes.
setr cam_disableCameraShake true

# Desativa a mira customizada do cliente.
setr cl_customCrosshair false

# Permite que veículos atravessem pequenas colisões como para-brisas (melhora jogabilidade em RP).
setr game_enableFlyThroughWindscreen true

# Desativa efeitos gráficos de perfil (como filtros de câmera).
setr profile_skfx 0

# Ativa sincronização de voz para proximidade entre jogadores.
setr voice_syncData 1

# Usa o áudio nativo do FiveM para voice chat.
setr voice_enableNativeAudio true
setr voice_useNativeAudio true

# CAPACIDADE DO SERVIDOR
# Número máximo de jogadores permitidos dependendo do seu plano/servidor
sv_maxclients 7

# Obriga os jogadores a usarem a versão do GTA correspondente (3570 nesse caso).
set sv_enforceGameBuild 3570

# Controla restrições de entidade (objetos, veículos, peds). "relaxed" permite mais liberdade.
set sv_entityLockdown false

# Filtra pedidos de conexão de clientes, nível 4 é padrão para segurança equilibrada.
set sv_filterRequestControl 4

# INCREASES
# Reserva de memória (increase_pool_size)

increase_pool_size "CMoveObject" 75
# Controla objetos móveis do mapa (portões, elevadores, props animados).
# Evita bugs de objetos que não se movem ou somem em mapas custom.

increase_pool_size "FragmentStore" 14000
# Fragmentos de modelos destrutíveis (carros amassando, props quebráveis).
# Essencial para servidores com muitos veículos, colisões e mapas MLO.

increase_pool_size "OcclusionInteriorInfo" 20
# Informações de oclusão dentro de interiores (MLOs).
# Evita flicker, paredes invisíveis e queda de FPS em interiores.

increase_pool_size "OcclusionPathNode" 5000
# Caminhos de oclusão usados pelo sistema de visibilidade do mapa.
# Importante para mapas grandes e cidades custom.

increase_pool_size "OcclusionPortalEntity" 750
# Entidades usadas para esconder/mostrar partes do mapa dinamicamente.
# Ajuda em prédios, túneis e interiores complexos.

increase_pool_size "OcclusionPortalInfo" 750
# Dados lógicos dos portais de oclusão.
# Trabalha junto com o PortalEntity para otimização visual.

increase_pool_size "PortalInst" 225
# Instâncias de portais entre áreas/interiores.
# Evita sumiço de partes do mapa ao entrar/sair de prédios.

increase_pool_size "ScaleformStore" 200
# Interface gráfica do GTA (HUD, NUI nativa, telas animadas).
# Importante para servidores com muitos UIs, tablets, celulares e painéis.

increase_pool_size "StaticBounds" 5000
# Limites estáticos de colisão do mapa.
# Essencial para mapas grandes, cidades custom e MLOs pesados.

increase_pool_size "TxdStore" 26000
# Texturas carregadas na memória (roupas, carros, mapas, HUD).
# Um dos MAIS importantes — evita texturas invisíveis ou “texture loss”.

# CHAVES OBRIGATÓRIAS
# Steam API Key (necessária para identificação Steam, gerada em https://steamcommunity.com/dev/apikey)
set steam_webApiKey "SUA_STEAM_WEB_API_KEY"

# License key do FiveM (gerada no https://portal.cfx.re/)
sv_licenseKey "SUA_CFX_LICENSE_KEY"
